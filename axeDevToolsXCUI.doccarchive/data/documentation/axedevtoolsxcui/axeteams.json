":"text","text":"‘s, say) one client’s login would otherwise wipe an injection that"},{"type":"text","text":" "},{"type":"text","text":"belongs to another. A host that logs out injects an empty array, which is honoured."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reads never throw and never block on a lookup: an unknown actor sends "},{"code":"teams: []","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"rather than dropping an MAU-qualifying event over an optional dimension."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"The host-injection channel for the actor’s team memberships, which are stamped onto","type":"text"},{"text":" ","type":"text"},{"text":"every usage service and Amplitude event so MAU reporting can slice by team without a","type":"text"},{"text":" ","type":"text"},{"text":"later join against billing-service (#3130).","type":"text"}],"variants":[{"paths":["\/documentation\/axedevtoolsxcui\/axeteams"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/axedevtoolsxcui\/axeteams"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams"},"hierarchy":{"paths":[["doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams\/setTeams(_:)"],"anchor":"Type-Methods","title":"Type Methods"}],"references":{"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeams/setTeams(_:)":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"+ ","kind":"text"},{"text":"setTeams:","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Replaces the team memberships stamped on subsequent events, for every client in"},{"type":"text","text":" "},{"text":"this process.","type":"te