},{"text":", which is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" stored here. ","type":"text"},{"code":"AxeClient","type":"codeVoice"},{"text":" keeps the teams walnut returned","type":"text"},{"text":" ","type":"text"},{"text":"for its own session on the client itself, beside ","type":"text"},{"code":"analyticsUserId","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"analyticsOrgName","type":"codeVoice"},{"text":", and hands them to ","type":"text"},{"code":"Amplitude","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UsageServiceClient","type":"codeVoice"},{"text":" when it","type":"text"},{"text":" ","type":"text"},{"text":"constructs them. Keeping them per client is what stops two live ","type":"text"},{"code":"AxeDevTools","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instances (a host’s own session and ","type":"text"},{"code":"AutoScanManager","type":"codeVoice"},{"text":"‘s, say) from stamping each","type":"text"},{"text":" ","type":"text"},{"text":"other’s teams onto their events.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Injection","type":"text"}],"type":"strong"},{"text":", which is stored here, because it is genuinely process-wide: a host","type":"text"},{"text":" ","type":"text"},{"text":"app calling ","type":"text"},{"code":"setTeams(_:)","type":"codeVoice"},{"text":" is asserting who is signed in ","type":"text"},{"inlineContent":[{"text":"right now","type":"text"}],"type":"emphasis"},{"type":"text","text":", not speaking"},{"type":"text","text":" "},{"text":"for one client. An injected value therefore overrides the login value on every","type":"text"},{"text":" ","type":"text"},{"text":"client until a login supersedes it.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An injection outlives any one SDK session and is cleared only by the hos