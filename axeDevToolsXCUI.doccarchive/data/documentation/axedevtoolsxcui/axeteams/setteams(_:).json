{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","roleHeading":"Type Method","role":"symbol","title":"setTeams(_:)","externalID":"c:@M@axeDevToolsXCUI@objc(cs)AxeTeams(cm)setTeams:","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setTeams","kind":"identifier"},{"text":"([","kind":"text"},{"text":"AxeTeam","kind":"typeIdentifier","preciseIdentifier":"c:@M@axeDevToolsXCUI@objc(cs)AxeTeam"},{"text":"])","kind":"text"}],"navigatorTitle":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setTeams:"}],"modules":[{"name":"axeDevToolsXCUI"}]},"abstract":[{"type":"text","text":"Replaces the team memberships stamped on subsequent events, for every client in"},{"type":"text","text":" "},{"type":"text","text":"this process."}],"variants":[{"paths":["\/documentation\/axedevtoolsxcui\/axeteams\/setteams(_:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/axedevtoolsxcui\/axeteams\/setteams(_:)"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI","doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setTeams","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"teams","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"c:@M@axeDevToolsXCUI@objc(cs)AxeTeam","text":"AxeTeam","kind":"typeIdentifier","identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeam"},{"text":"])","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"teams","content":[{"type":"paragraph","inlineContent":[{"text":"The actor’s current team memberships. Pass an empty array to clear.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Intended for a host app that drives the SDK in-process and owns its own login","type":"text"},{"text":" ","type":"text"},{"text":"session, which outlives any one SDK session. Call it on every session change,","type":"text"},{"text":" ","type":"text"},{"text":"including logout, where the correct value is an empty array. An injected empty","type":"text"},{"text":" ","type":"text"},{"text":"array means “this user has no teams” and is honoured; it does not fall back to","type":"text"},{"text":" ","type":"text"},{"text":"whatever a login found.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shipped on iOS for API parity with Android, where the Analyzer is the caller. No"},{"type":"text","text":" "},{"type":"text","text":"in-process iOS host uses it today: everything reaching this SDK arrives through"},{"type":"text","text":" "},{"type":"text","text":"Appium, and a fresh session there means a fresh fetch. In "},{"code":"axeDevToolsXCUI_noauth","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which compiles without analytics, nothing reads this value and no events are sent;"},{"type":"text","text":" "},{"type":"text","text":"it ships there for API-surface parity only."}]},{"type":"paragraph","inlineContent":[{"text":"Entries are dropped rather than sent, and the rest of the array still applies, when","type":"text"},{"text":" ","type":"text"},{"text":"the id is blank, when either field carries control characters, or when either field","type":"text"},{"text":" ","type":"text"},{"text":"exceeds 256 unicode scalars. Past 100 entries the array is truncated. Every drop is","type":"text"},{"text":" ","type":"text"},{"text":"logged. A blank ","type":"text"},{"inlineContent":[{"type":"text","text":"name"}],"type":"emphasis"},{"type":"text","text":" is kept: the id is the identity."}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams\/setTeams(_:)"},"references":{"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeam":{"navigatorTitle":[{"text":"AxeTeam","kind":"identifier"}],"title":"AxeTeam","type":"topic","abstract":[{"type":"text","text":"One team membership of the actor driving this process."}],"url":"\/documentation\/axedevtoolsxcui\/axeteam","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxeTeam","kind":"identifier"}],"identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeam"},"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI":{"abstract":[],"title":"axeDevToolsXCUI","url":"\/documentation\/axedevtoolsxcui","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI"},"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeams/setTeams(_:)":{"navigatorTitle":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setTeams:"}],"title":"setTeams(_:)","type":"topic","abstract":[{"text":"Replaces the team memberships stamped on subsequent events, for every client in","type":"text"},{"text":" ","type":"text"},{"text":"this process.","type":"text"}],"url":"\/documentation\/axedevtoolsxcui\/axeteams\/setteams(_:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setTeams"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"c:@M