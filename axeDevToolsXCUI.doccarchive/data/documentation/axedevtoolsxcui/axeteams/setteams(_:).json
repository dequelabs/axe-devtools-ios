"]}]},{"parameters":[{"name":"teams","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The actor’s current team memberships. Pass an empty array to clear."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Intended for a host app that drives the SDK in-process and owns its own login"},{"type":"text","text":" "},{"type":"text","text":"session, which outlives any one SDK session. Call it on every session change,"},{"type":"text","text":" "},{"type":"text","text":"including logout, where the correct value is an empty array. An injected empty"},{"type":"text","text":" "},{"type":"text","text":"array means “this user has no teams” and is honoured; it does not fall back to"},{"text":" ","type":"text"},{"text":"whatever a login found.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Shipped on iOS for API parity with Android, where the Analyzer is the caller. No","type":"text"},{"text":" ","type":"text"},{"text":"in-process iOS host uses it today: everything reaching this SDK arrives through","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Appium, and a fresh session there means a fresh fetch. In "},{"type":"codeVoice","code":"axeDevToolsXCUI_noauth"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"which compiles without analytics, nothing reads this value and no events are sent;"},{"text":" ","type":"text"},{"type":"text","text":"it ships there for API-surface parity only."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Entries are dropped rather than sent, and the rest of the array still applies, when"},{"type":"text","text":" "},{"type":"text","text":"the id is blank, when either field carries control characters, or when either field"},{"type":"text","text":" "},{"type":"text","text":"exceeds 256 unicode scalars. Past 100 entries the array is truncated. Every drop is"},{"type":"text","text":" "},{"type":"text","text":"logged. A blank "},{"type":"emphasis","inlineContent":[{"type":"text","text":"name"}]},{"type":"text","text":" is kept: the id is the identity."}],"type":"paragraph"}]}],"abstract":[{"text":"Replaces the team memberships stamped on subsequent events, for every client in","type":"text"},{"text":" ","type":"text"},{"text":"this process.","type":"text"}],"references":{"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeam":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxeTeam"}],"identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeam","navigatorTitle":[{"kind":"identifier","text":"AxeTeam"}],"kind":"symbol","type":"topic","role":"symbol","title":"AxeTeam","abstract":[{"type":"text","text":"One team membership of the actor driving this process."}],"url":"\/documentation\/axedevtoolsxcui\/axeteam"},"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI","role":"collection","url":"\/documentation\/axedevtoolsxcui","abstract":[],"title":"axeDevToolsXCUI"},"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeams":{"type":"topic","navigatorTitle":[{"text":"AxeTeams","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxeTeams","kind":"identifier"}],"abstract":[{"type":"text","text":"The host-injection channel for the actor’s team memberships, which are stamped onto"},{"type":"text","text":" "},{"type":"text","text":"every usage service and Amplitude event so MAU reporting can slice by team without a"},{"type":"text","text":" "},{"type":"text","text":"later join against billing-service (#3130)."}],"url":