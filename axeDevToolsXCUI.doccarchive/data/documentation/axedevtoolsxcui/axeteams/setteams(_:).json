{"hierarchy":{"paths":[["doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI","doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams"]]},"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setTeams"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"AxeTeam","preciseIdentifier":"c:@M@axeDevToolsXCUI@objc(cs)AxeTeam"},{"kind":"text","text":"])"}],"title":"setTeams(_:)","symbolKind":"method","roleHeading":"Type Method","modules":[{"name":"axeDevToolsXCUI"}],"navigatorTitle":[{"text":"+ ","kind":"text"},{"text":"setTeams:","kind":"identifier"}],"role":"symbol","externalID":"c:@M@axeDevToolsXCUI@objc(cs)AxeTeams(cm)setTeams:"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setTeams"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"teams"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"AxeTeam","preciseIdentifier":"c:@M@axeDevToolsXCUI@objc(cs)AxeTeam","identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeam"},{"kind":"text","text":"])"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"teams","content":[{"inlineContent":[{"type":"text","text":"The actor’s current team memberships. Pass an empty array to clear."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Intended for a host app that drives the SDK in-process and owns its own login","type":"text"},{"text":" ","type":"text"},{"text":"session, which outlives any one SDK session. Call it on every session change,","type":"text"},{"text":" ","type":"text"},{"text":"including logout, where the correct value is an empty array. An injected empty","type":"text"},{"text":" ","type":"text"},{"text":"array means “this user has no teams” and is honoured; it does not fall back to","type":"text"},{"text":" ","type":"text"},{"text":"whatever a login found.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Shipped on iOS for API parity with Android, where the Analyzer is the caller. No","type":"text"},{"text":" ","type":"text"},{"text":"in-process iOS host uses it today: everything reaching this SDK arrives through","type":"text"},{"text":" ","type":"text"},{"text":"Appium, and a fresh session there means a fresh fetch. In ","type":"text"},{"code":"axeDevToolsXCUI_noauth","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which compiles without analytics, nothing reads this value and no events are sent;","type":"text"},{"text":" ","type":"text"},{"text":"it ships there for API-surface parity only.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Entries are dropped rather than sent, and the rest of the array still applies, when","type":"text"},{"text":" ","type":"text"},{"text":"the id is blank, when either field carries control characters, or when either field","type":"text"},{"text":" ","type":"text"},{"text":"exceeds 256 unicode scalars. Past 100 entries the array is truncated. Every drop is","type":"text"},{"text":" ","type":"text"},{"text":"logged. A blank ","type":"text"},{"inlineContent":[{"type":"text","text":"name"}],"type":"emphasis"},{"text":" is kept: the id is the identity.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axedevtoolsxcui\/axeteams\/setteams(_:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/axedevtoolsxcui\/axeteams\/setteams(_:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams\/setTeams(_:)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Replaces the team memberships stamped on subsequent events, for every client in"},{"type":"text","text":" "},{"type":"text","text":"this process."}],"sections":[],"references":{"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeam":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxeTeam","kind":"identifier"}],"title":"AxeTeam","navigatorTitle":[{"text":"AxeTeam","kind":"identifier"}],"url":"\/documentation\/axedevtoolsxcui\/axeteam","abstract":[{"type":"text","text":"One team membership of the actor driving this process."}],"identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeam","role":"symbol","type":"topic","kind":"symbol"},"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeTeams":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxeTeams","kind":"identifier"}],"title":"AxeTeams","navigatorTitle":[{"text":"AxeTeams","kind":"identifier"}],"url":"\/documentation\/axedevtoolsxcui\/axeteams","abstract":[{"type":"text","text":"The host-injection channel for the actor’s team memberships, which are stamped onto"},{"type":"text","text":" "},{"type":"text","text":"every usage service and Amplitude event so MAU reporting can slice by team without a"},{"type":"text","text":" "},{"type":"text","text":"later join against billing-service (#3130)."}],"identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeTeams","role":"symbol","type":"topic","kind":"symbol"},"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI":{"title":"axeDevToolsXCUI","url":"\/documentation\/axedevtoolsxcui","identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI","