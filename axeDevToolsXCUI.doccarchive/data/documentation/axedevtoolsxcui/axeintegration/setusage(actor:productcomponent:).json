{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeIntegration\/setUsage(actor:productComponent:)"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"setUsage"},{"kind":"text","text":"("},{"kind":"externalParam","text":"actor"},{"kind":"text","text":": "},{"identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeUsageActor","preciseIdentifier":"c:@M@axeDevToolsXCUI@E@AxeUsageActor","kind":"typeIdentifier","text":"AxeUsageActor"},{"kind":"text","text":", "},{"text":"productComponent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"parameters":[{"name":"actor","content":[{"inlineContent":[{"type":"text","text":"Whether a person or an automated run triggered the session."}],"type":"paragraph"}]},{"name":"productComponent","content":[{"inlineContent":[{"type":"text","text":"The upstream product surface, unsuffixed, e.g. "},{"type":"codeVoice","code":"mcp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"appium"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Call this before session init."}],"type":"strong"},{"type":"text","text":" A session captures these values when it starts"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"AxeClient.usageAttribution"},{"type":"text","text":"), and its usage-service events and session-init analytics"},{"type":"text","text":" "},{"type":"text","text":"event are all stamped from that one capture."},{"type":"text","text":" "},{"type":"text","text":"A call that lands afterwards therefore applies to the "},{"inlineContent":[{"text":"next","type":"text"}],"type":"emphasis"},{"type":"text","text":" session started in this"},{"type":"text","text":" "},{"type":"text","text":"process, never to one already running. There is no warning for a late call, because"},{"text":" ","type":"text"},{"type":"text","text":"the process cannot tell a mistimed call apart from correct setup for the next session."}]},{"inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"declareProduct"},{"type":"text","text":", which ignores a conflicting second call, this is last write"},{"type":"text","text":" "},{"type":"text","text":"wins. The SDK appends the platform suffix, so pass "},{"type":"codeVoice","code":"appium"},{"type":"text","text":", not "},{"type":"codeVoice","code":"appium-ios"},{"type":"text","text":". A"},{"text":" ","type":"text"},{"type":"codeVoice","code":"productComponent"},{"type":"text","text":" that sanitizes to nothing leaves the previous value in place"},{"type":"text","text":" "},{"type":"text","text":"rather than clearing it; the "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" from the same call still applies."}],"type":"paragraph"}]}],"metadata":{"externalID":"c:@M@axeDevToolsXCUI@objc(cs)AxeIntegration(cm)setUsageWithActor:productComponent:","navigatorTitle":[{"text":"+ ","kind":"text"},{"text":"setUsageWithActor:productComponent:","kind":"identifier"}],"modules":[{"name":"axeDevToolsXCUI"}],"symbolKind":"method","role":"symbol","title":"setUsage(actor:productComponent:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"setUsage"},{"kind":"text","tex