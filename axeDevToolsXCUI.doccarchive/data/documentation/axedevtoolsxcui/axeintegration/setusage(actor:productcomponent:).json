run triggered the session."}]}],"name":"actor"},{"name":"productComponent","content":[{"type":"paragraph","inlineContent":[{"text":"The upstream product surface, unsuffixed, e.g. ","type":"text"},{"type":"codeVoice","code":"mcp"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"appium"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Call this before session init."}]},{"text":" A session captures these values when it starts","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"AxeClient.usageAttribution"},{"text":"), and its usage-service events and session-init analytics","type":"text"},{"text":" ","type":"text"},{"text":"event are all stamped from that one capture.","type":"text"},{"text":" ","type":"text"},{"text":"A call that lands afterwards therefore applies to the ","type":"text"},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"text":" session started in this","type":"text"},{"text":" ","type":"text"},{"text":"process, never to one already running. There is no warning for a late call, because","type":"text"},{"type":"text","text":" "},{"text":"the process cannot tell a mistimed call apart from correct setup for the next session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"declareProduct"},{"type":"text","text":", which ignores a conflicting second call, this is last write"},{"type":"text","text":" "},{"type":"text","text":"wins. The SDK appends the platform suffix, so pass "},{"type":"codeVoice","code":"appium"},{"type":"text","text":", not "},{"type":"codeVoice","code":"appium-ios"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"codeVoice","code":"productComponent"},{"type":"text","text":" that sanitizes to nothing leaves the previous value in place"},{"type":"text","text":" "},{"type":"text","text":"rather than clearing it; the "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" from the same call still applies."}]}]}],"variants":[{"paths":["\/documentation\/axedevtoolsxcui\/axeintegration\/setusage(actor:productcomponent:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/axedevtoolsxcui\/axeintegration\/setusage(actor:productcomponent:)"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI","doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeIntegration"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeIntegration\/setUsage(actor:productComponent:)","interfaceLanguage":"swift"},"abstract":[{"text":"Called once per process by the integrating layer (the Appium driver, the Desktop","type":"text"},{"text":" ","type":"text"},{"text":"Analyzer, MCP) to say who triggered this session and which product surface it came","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from. Public so those layers can call it; deliberately absent from customer docs and"},{"text":" ","type":"text"},{"text":"not part of the supported surface.","type":"text"}],"references":{"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeUsageActor":{"url":"\/documentation\/axedevtoolsxcui\/axeusageactor","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AxeUsageActor","kind":"identifier"}],"navigatorTitle":[{"text":"AxeUsageActor","kind":"identifier"}],"title":"AxeUsageActor","abstract":[{"text":"Who triggered a scan session, for MAU reporting.","type":"text"}],"identifier":"doc:\/\/com.deque.axeDevToolsXCUI\/documentation\/axeDevToolsXCUI\/AxeUsageActor"},"doc://com.deque.axeDevToolsXCUI/docu