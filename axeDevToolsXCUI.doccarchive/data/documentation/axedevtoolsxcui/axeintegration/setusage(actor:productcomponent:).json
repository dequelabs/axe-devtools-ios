t":", "},{"kind":"externalParam","text":"productComponent"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":")"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Whether a person or an automated run triggered the session."}],"type":"paragraph"}],"name":"actor"},{"content":[{"inlineContent":[{"type":"text","text":"The upstream product surface, unsuffixed, e.g. "},{"type":"codeVoice","code":"mcp"},{"type":"text","text":" or "},{"type":"codeVoice","code":"appium"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"productComponent"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Call this before session init."}],"type":"strong"},{"type":"text","text":" A session captures these values when it starts"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"AxeClient.usageAttribution","type":"codeVoice"},{"type":"text","text":"), and its usage-service events and session-init analytics"},{"type":"text","text":" "},{"type":"text","text":"event are all stamped from that one capture."},{"type":"text","text":" "},{"type":"text","text":"A call that lands afterwards therefore applies to the "},{"inlineContent":[{"type":"text","text":"next"}],"type":"emphasis"},{"type":"text","text":" session started in this"},{"type":"text","text":" "},{"type":"text","text":"process, never to one already running. There is no warning for a late call, because"},{"type":"text","text":" "},{"type":"text","text":"the process cannot tell a mistimed call apart from correct setup for the next session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Unlike "},{"code":"declareProduct","type":"codeVoice"},{"type":"text","text":", which ignores a conflicting second call, this is last write"},{"type":"text","text":" "},{"type":"text","text":"wins. The SDK appends the platform suffix, so pass "},{"code":"appium","type":"codeVoice"},{"type":"text","text":", not "},{"code":"appium-ios","type":"codeVoice"},{"type":"text","text":". A"},{"type":"text","text":" "},{"code":"productComponent","type":"codeVoice"},{"type":"text","text":" that sanitizes to nothing leaves the previous value in place"},{"type":"text","text":" "},{"type":"text","text":"rather than clearing it; the "},{"code":"actor","type":"codeVoice"},{"type":"text","text":" from the same call still applies."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/axedevtoolsxcui\/axeintegration\/setusage(actor:productcomponent:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/axedevtoolsxcui\/axeintegration\/setusage(actor:productcomponent:)"]}],"abstract":[{"text":"Called once per process by the integrating layer (the Appium driver, the Desktop","type":"text"},{"text":" ","type":"text"},{"text":"Analyzer, MCP) to say who triggered this session and which product surface it came","type":"text"},{"text":" ","type":"text"},{"text":"from. Public so those layers can call it; deliberately absent from customer docs and","type":"text"},{"text":" ","type":"text"},{"text":"not part of the supported surface.","type":"text"}],"references":{"doc://com.deque.axeDevToolsXCUI/documentation/axeDevToolsXCUI/AxeIntegration":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AxeIntegration"}],"title":"AxeIntegration","navigatorTitle":[{"kind":"identifier","text":"AxeIntegration"}],"url":"\/documentation\/axedevtoolsxcui\/axeintegration","abstract":[{"text":"Lets a downstream integration (WebDriverAgent, the Desktop Mobile Analyzer) declare","type":"text"},{"text":" ","type":"text"},{"text":"which product is driving the current process, so Amplitude can distinguish an","type":"text"},{"text":" "